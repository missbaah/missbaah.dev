---
// imports
import Nav from "../components/Nav.astro"
import { Font } from "astro:assets"
import "@radix-ui/themes/styles.css"
import "../styles/global.css"

const {
  pageTitle = "Beebe Brako · Software Engineer",
  description = "Learning, shipping as I go. Nearly 4 years shipping SaaS, marketplace and fleet products.",
  // Leaves out the nav and its rule, for pages that stand alone (the 404)
  bare = false,
} = Astro.props
const ogImage = new URL("/og-image.png", Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Link previews when the site is shared -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Beebe Brako" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content="Illustrated avatar of Beebe Brako" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={ogImage} />
    <Font cssVariable="--font-aeonik-pro" />
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-gochi" />
  </head>
  <body class="min-h-screen bg-cream text-text-color">
    <main class="flex flex-col h-full items-start px-4 pb-16 md:px-[20%]">
      {
        !bare && (
          <>
            <section>
              <Nav />
            </section>
            <hr class="w-full text-line" />
          </>
        )
      }
      <section class="w-full min-w-0">
        <slot />
      </section>
      <!-- <section class="lg:col-span-2 sticky top-16">crossword here</section> -->
    </main>
  </body>
</html>
