---
// imports
import Nav from "../components/Nav.astro"
import { Font } from "astro:assets"

const { pageTitle } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <Font cssVariable="--font-aeonik-pro" />
    <Font cssVariable="--font-inter" />
  </head>
  <body
    class="grid lg:grid-cols-9 md:grid-cols-1 gap-10 items-start xl:max-w-6xl lg:max-w-4xl md:max-w-2xl mx-auto px-4 md:px-0 lg:px-0 mt-10 lg:mt-16 overflow-auto relative"
  >
    <section class="lg:col-span-2">
      <Nav />
    </section>
    <section class="lg:col-span-5">
      <slot />
    </section>
    <section class="lg:col-span-2 sticky top-16">crossword here</section>
  </body>
</html>
