---
//imports
import clsx from "clsx"
interface FooterProps {
  class?: string
}

const { class: className } = Astro.props

const links = [
  { label: "Email", href: "mailto:missbaah.brako@gmail.com" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/adwoaaddobrako/" },
  { label: "GitHub", href: "https://github.com/missbaah" },
]
---

<footer
  class={clsx(
    className,
    "flex flex-wrap items-baseline gap-x-3 gap-y-1 font-aeonik text-ink-soft"
  )}
>
  <span class="font-hand text-lg">Find me on</span>
  {
    links.map((link, i) => (
      <>
        {i > 0 && (
          <span aria-hidden="true" class="text-separator">
            /
          </span>
        )}
        <a
          href={link.href}
          class="marker-sweep"
          {...(link.href.startsWith("http") && {
            target: "_blank",
            rel: "noopener noreferrer",
          })}
        >
          {link.label}
        </a>
      </>
    ))
  }
</footer>
