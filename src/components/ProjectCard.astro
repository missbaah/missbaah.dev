---
interface Props {
  title: string
  description: string
  imgsrc: string
}

const { title, description, imgsrc } = Astro.props
---

<div
  class="size-20 rounded-2xl p-4.5 border border-[#EAEAE9] flex items-center justify-center"
>
  <img src={imgsrc} alt={title} class="size-16 object-cover" />
</div>
