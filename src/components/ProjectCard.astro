---
interface Props {
    title: string;
    description: string;
    href: string;
    link: string;

}

const { title, description, href, link } = Astro.props;
---

<a href={href} class="border p-4 rounded-lg hover:shadow-md transition-shadow duration-200 block">
    <h3 class="capitalize font-semibold">{title}</h3>
    <p>{description}</p>
    <p class="mt-2 text-sm text-blue-600 underline">{link}</p>
</a>

