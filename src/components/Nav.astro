---
//imports
import clsx from "clsx"

// js
const navItems = [
  { name: "Home", path: "/" },
  { name: "Projects", path: "/projects" },
  { name: "Blog", path: "/blog" },
  { name: "Notes", path: "/notes" },
  { name: "About", path: "/about" },
]
const { pathname } = Astro.url
---

<nav
  class="flex flex-col text-[#595959] font-medium w-[90%] md:w-fit mx-4 md:mx-0"
>
  <div class="flex md:flex-col gap-2 justify-between">
    {
      navItems.map((item) => {
        return (
          <a
            class={clsx(
              { "after:w-1/3 text-black font-bold": item.path === pathname },
              "font-inter relative after:absolute after:bottom-0 after:left-0 after:h-px after:bg-black after:w-0"
            )}
            href={item.path}
          >
            {item.name}
          </a>
        )
      })
    }
  </div>
  <hr class="my-6 border-t w-1/3 border-[#0000001A] hidden md:block" />
  <section class="hidden md:block">
    <p>Find me on</p>
    <div class="flex gap-3 mt-1.5 text-black text-sm">
      <a
        href="https://www.linkedin.com/in/adwoaaddobrako/"
        target="_blank"
        class="i-lucide-linkedin text-xl"></a>
      <a
        href="https://github.com/missbaah"
        target="_blank"
        class="i-lucide-github text-xl"></a>
      <a href="mailto:missbaah.brako@gmail.com" class="i-lucide-mail text-xl"
      ></a>
    </div>
  </section>
</nav>
