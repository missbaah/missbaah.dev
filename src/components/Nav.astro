---
//imports
import clsx from "clsx"
import Footer from "./Footer.astro"

// js
const navItems = [
  { name: "Home", path: "/" },
  { name: "Projects", path: "/projects" },
  // { name: "Blog", path: "/blog" },
  // { name: "Notes", path: "/notes" },
  { name: "About", path: "/about" },
]
const { pathname } = Astro.url
---

<nav class="flex w-full pt-8.5 pb-6">
  <div class="flex md:gap-6 gap-3 justify-between">
    {
      navItems.map((item) => {
        return (
          <a
            class={clsx(
              {
                "underline underline-offset-8 decoration-pink-strong text-ink decoration-[3px] font-bold":
                  item.path === pathname,
              },
              "text-ink-soft md:text-lg"
            )}
            href={item.path}
          >
            {item.name}
          </a>
        )
      })
    }
  </div>
</nav>
