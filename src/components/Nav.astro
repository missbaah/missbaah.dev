---
//imports
import clsx from "clsx"

// js
const navItems = [
  { name: "Home", path: "/" },
  { name: "Projects", path: "/projects" },
  // { name: "Blog", path: "/blog" },
  // { name: "Notes", path: "/notes" },
  { name: "About", path: "/about" },
]
// Strip the trailing slash so "/projects/" in the built site matches "/projects"
const pathname = Astro.url.pathname.replace(/(.)\/$/, "$1")
---

<nav class="flex w-full md:pt-8.5 md:pb-6 p-5">
  <div class="flex md:gap-8 gap-6 justify-between">
    {
      navItems.map((item) => {
        return (
          <a
            class={clsx(
              item.path === pathname ? "marker marker-draw font-bold" : "marker-sweep",
              "md:text-lg"
            )}
            href={item.path}
          >
            {item.name}
          </a>
        )
      })
    }
  </div>
</nav>
