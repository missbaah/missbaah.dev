---
//imports
import clsx from "clsx"
import Footer from "./Footer.astro"

// js
const navItems = [
  { name: "Home", path: "/" },
  { name: "Projects", path: "/projects" },
  // { name: "Blog", path: "/blog" },
  // { name: "Notes", path: "/notes" },
  { name: "About", path: "/about" },
]
const { pathname } = Astro.url
---

<nav class="flex text-[#595959] font-medium w-[85%] md:w-full bg-white">
  <div class="flex md:gap-6 gap-3 justify-between">
    {
      navItems.map((item) => {
        return (
          <a
            class={clsx(
              {
                "after:w-2/3 text-black font-bold": item.path === pathname,
              },
              "font-inter relative after:absolute after:bottom-0 after:left-0 after:h-px after:bg-black after:w-0"
            )}
            href={item.path}
          >
            {item.name}
          </a>
        )
      })
    }
  </div>

  <!-- <Footer class="hidden lg:block" /> -->
</nav>
