---
//imports
import clsx from "clsx"
import Footer from "./Footer.astro"

// js
const navItems = [
  { name: "Home", path: "/" },
  { name: "Projects", path: "/projects" },
  { name: "Blog", path: "/blog" },
  { name: "Notes", path: "/notes" },
  { name: "About", path: "/about" },
]
const { pathname } = Astro.url
---

<nav
  class="flex flex-col text-[#595959] font-medium w-[85%] lg:w-fit md:w-3/5 mx-4 lg:mx-0 fixed bg-white"
>
  <div class="flex lg:flex-col lg:gap-4 md:gap-2.5 gap-2 justify-between">
    {
      navItems.map((item) => {
        return (
          <a
            class={clsx(
              {
                "after:w-2/3 lg:after:w-1/3 text-black font-bold":
                  item.path === pathname,
              },
              "font-inter relative after:absolute after:bottom-0 after:left-0 after:h-px after:bg-black after:w-0"
            )}
            href={item.path}
          >
            {item.name}
          </a>
        )
      })
    }
  </div>
  <hr class="my-6 border-t w-1/3 border-[#0000001A] hidden lg:block" />
  <Footer class="hidden lg:block" />
</nav>
