---
import Layout from "../layouts/Layout.astro"
import Doodle from "../components/Doodle.tsx"
import "../styles/global.css"

// Torn bottom edge for the note: an uneven zigzag, fixed so it never shifts
const teeth = [3, 7, 2, 6, 4, 8, 3, 6, 2, 7, 4, 6, 3, 8, 2, 5, 4, 7, 3, 6]
const tornEdge = `polygon(0 0, 100% 0, ${teeth
  .map((t, i) => {
    const x = 100 - (i * 100) / (teeth.length - 1)
    return `${x}% calc(100% - ${t}px)`
  })
  .join(", ")})`
---

<Layout pageTitle="Not found | Beebe Brako" bare>
  <!-- No nav here: a lone scrap torn off a page, taped down in the middle -->
  <div class="min-h-dvh flex items-center justify-center py-16 font-aeonik">
    <div
      class="relative w-full max-w-sm rotate-[-2deg] drop-shadow-[0_1px_2px_rgb(0_0_0/0.08)]"
    >
      <span
        aria-hidden="true"
        class="absolute z-10 -top-3 left-1/2 -translate-x-1/2 h-6 w-20 bg-pink/60 rotate-2"
      ></span>
      <div
        class="paper border border-line px-7 pt-8 pb-10 flex flex-col gap-5"
        style={{ clipPath: tornEdge }}
      >
        <p
          aria-hidden="true"
          class="self-end -mb-4 text-5xl font-bold text-line-strong rotate-3"
        >
          404
        </p>
        <h1 class="font-hand text-3xl leading-9 text-ink">
          you've wandered off the page
        </h1>
        <div class="flex flex-wrap gap-x-6 gap-y-2 font-hand text-xl">
          <a href="/" class="marker-sweep">
            <Doodle name="home" /> take me home
          </a>
          <a href="/projects/" class="marker-sweep">or see projects</a>
        </div>
      </div>
    </div>
  </div>
</Layout>
