---
import BlogPost from "../components/BlogPost.astro"
import Layout from "../layouts/Layout.astro"
import "../styles/global.css"

const MAX_POSTS = 5
const allPosts = Object.values(
  import.meta.glob("./posts/*.md", { eager: true })
).slice(0, MAX_POSTS)

const MAX_NOTES = 5
const allNotes = Object.values(
  import.meta.glob("./notes/*.md", { eager: true })
).slice(0, MAX_NOTES)
---

<Layout>
  <div class="flex flex-col">
    <img
      src="/notionface.png"
      alt="avatar"
      class="size-32 rounded-full object-center"
    />
    <div class="flex flex-col gap-4">
      <div class="flex gap-2">
        <h1 class="text-5xl md:text-6xl flex font-aeonik">Hi, I'm Adwoa</h1>
        <div class="flex items-center gap-1">
          <span class="text-[#21222333] text-lg font-bold i-lucide-volume-2"
          ></span>
          <span class="text-[#21222333] text-lg">Ah-jwah</span>
        </div>
      </div>

      <p class="md:w-3/4 font-aeonik">
        I build interfaces that feel considered, currently at Dexwin Tech,
        working on bringing African products to a world class standard. I also
        read too much, think alot about the web and solve word searches p.s
        there's one waiting for you ;)
      </p>
    </div>
  </div>
  <section class="mb-6">
    <h2 class="font-bold capitalize text-lg mb-6">Featured Projects</h2>
    {
      allPosts.length > 0 ? (
        allPosts.map((post: any) => {
          return (
            <BlogPost
              href={post.url}
              title={post.frontmatter.title}
              date={post.frontmatter.pubDate}
            />
          )
        })
      ) : (
        <code> // No posts yet</code>
      )
    }
  </section>
  <section class="mb-6">
    <h2 class="font-bold capitalize text-lg mb-6">Latest Posts</h2>
    {
      allNotes.length > 0 ? (
        allNotes.map((post: any) => {
          return (
            <BlogPost
              href={post.url}
              title={post.frontmatter.title}
              date={post.frontmatter.pubDate}
            />
          )
        })
      ) : (
        <code> // No notes yet </code>
      )
    }
  </section>
</Layout>
