---
import BlogPost from "../components/BlogPost.astro"
import Layout from "../layouts/Layout.astro"
import { projects } from "../data/project.ts"
import "../styles/global.css"
import ProjectGrid from "../components/ProjectGrid.tsx"
import GreetingClock from "../components/GreetingClock.tsx"
import Footer from "../components/Footer.astro"

const MAX_POSTS = 3
const allPosts = Object.values(
  import.meta.glob("./posts/*.md", { eager: true })
).slice(0, MAX_POSTS)

const MAX_NOTES = 5
const allNotes = Object.values(
  import.meta.glob("./notes/*.md", { eager: true })
).slice(0, MAX_NOTES)

// homepage curation, independent of the Projects page's status grouping
const featuredProjects = projects.filter((project) => project.featured)
---

<Layout>
  <div class="grid gap-6 mt-6">
    <div class="text-ink-soft">
      <GreetingClock client:load />
    </div>
    <div class="flex flex-col md:flex-row gap-10 md:items-start">
      <div class="flex flex-col gap-6 w-3/4 font-aeonik">
        <h1 class="text-3xl md:text-6xl flex font-bold">
          Adwoa Baah Addo-Brako
        </h1>
        <p class="text-2xl leading-8">
          I build interfaces that feel considered
        </p>
        <p class="text-base leading-7 text-ink-soft w-fit">
          At Dexwin Tech, working on bringing African products to a world class
          standard. I also read too much, think a lot about the web and solve
          word searches p.s there's one waiting for you ;)
        </p>
      </div>
      <img
        src="/notionface.png"
        alt="avatar"
        class="size-24 md:size-44 shrink-0 mx-auto md:mx-0"
      />
    </div>

    <hr class="border-b w-full border-[#EAEAE9]" />
    <section class="flex flex-col py-4 gap-6 w-full">
      <h2 class="capitalize text-gray-light text-sm">Featured Projects</h2>
      <ProjectGrid projects={featuredProjects} client:load />
    </section>
    <hr class="w-full text-line" />
    <Footer class="block" />
  </div>
</Layout>
