---
import BlogPost from '../components/BlogPost.astro';
import Layout from '../layouts/Layout.astro';

const MAX_POSTS = 5;
const allPosts = Object.values(import.meta.glob('./posts/*.md', {eager: true})).slice(0, MAX_POSTS)

const MAX_NOTES = 5;
const allNotes = Object.values(import.meta.glob('./notes/*.md', {eager: true})).slice(0, MAX_NOTES)

---

<Layout>

    <div class="flex flex-col md:flex-row justify-between items-center mb-6">
    <div class="flex flex-col gap-4 md:order-1 order-2">
        <p class="text-2xl md:text-3xl"> Hi, I'm Adwoa <span class="bg-orange-100 text-orange-500 text-lg p-1 rounded-full">miss baah</span> </p>
        <p class="md:w-3/4">I build interfaces that feel considered, currently at Dexwin Tech, working on bringing African products to a world class standard. I also read too much, think alot about the web and solve word searches p.s there's one waiting for you ;)</p>
        <p class="flex gap-5">Find me on <span class="flex gap-3"><a href="https://www.linkedin.com/in/adwoaaddobrako/" target="_blank" class="i-lucide-linkedin text-base"></a> <a href="https://github.com/missbaah" target="_blank" class="i-lucide-github text-base"></a> <a href="mailto:missbaah.brako@gmail.com" class="i-lucide-mail text-base"></a> </span>  </p>
    </div>
    <img src="/notionface.png" alt="drawing" width="250" class="items-start md:order-2 order-1">
    </div>
<section class="mb-6">
    <h2 class="font-bold capitalize text-lg mb-6">Featured Projects</h2>
    {
      allPosts.length > 0 ?  allPosts.map((post:any)=>{
            return <BlogPost href={post.url} title={post.frontmatter.title} date={post.frontmatter.pubDate} />
        }) : <code> // No posts yet</code>
    }
</section>
<section class="mb-6">
    <h2 class="font-bold capitalize text-lg mb-6">Latest Posts</h2>
    {
       allNotes.length > 0 ? allNotes.map((post:any)=>{
            return <BlogPost href={post.url} title={post.frontmatter.title} date={post.frontmatter.pubDate} />
        }) : <code> // No notes yet  </code>
    }
</section>
</Layout>
