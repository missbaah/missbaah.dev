---
import Layout from "../layouts/Layout.astro"
import { projects } from "../data/project.ts"
import "../styles/global.css"
import ProjectGrid from "../components/ProjectGrid.tsx"
import FeaturedProject from "../components/FeaturedProject.tsx"
import GreetingClock from "../components/GreetingClock.tsx"
import Footer from "../components/Footer.astro"
import Doodle from "../components/Doodle.tsx"

// homepage curation, independent of the Projects page's status grouping
// exactly one project is `featured: true` — see CONTEXT.md "Featured is a singleton"
const featuredProject = projects.find((project) => project.featured)
const otherProjects = projects.filter((project) => !project.featured)
---

<Layout>
  <div class="grid gap-6 mt-6">
    <div class="text-ink-soft">
      <GreetingClock client:load />
    </div>
    <div class="flex flex-col md:flex-row gap-10 md:items-start">
      <div
        class="flex flex-col gap-6 w-full md:w-3/4 font-aeonik order-2 md:order-1"
      >
        <h1 class="text-3xl md:text-6xl flex font-bold">
          Adwoa Baah Addo-Brako
        </h1>
        <p class="text-lg md:text-2xl leading-8">Learning, shipping as I go</p>
        <p class="text-base leading-7 text-ink-soft w-fit">
          Software engineer at Dexwin Tech, bringing African products to a world
          class standard, with nearly 4 years shipping SaaS, marketplace and
          fleet products. I also read too much, think a lot about the web and
          solve puzzles.
          <a
            href="/about#word-search"
            class="marker font-hand text-lg leading-6"
          >
            p.s. there's one waiting for you ;) <Doodle name="arrow" />
          </a>
        </p>
      </div>
      <img
        src="/notionface.png"
        alt="avatar"
        class="size-24 md:size-44 shrink-0 order-1 md:order-2"
      />
    </div>

    <hr class="border-b w-full border-[#EAEAE9]" />

    {
      featuredProject && (
        <section class="flex flex-col gap-6 w-full">
          <div class="flex items-center justify-between">
            <h2 class="text-2xl font-aeonik font-bold">Featured</h2>
            <a
              href="/projects"
              class="text-sm text-pink-link hover:text-pink-link-hover transition-colors"
            >
              All projects <Doodle name="arrow" />
            </a>
          </div>
          <FeaturedProject {...featuredProject} client:load />
        </section>
      )
    }

    {
      otherProjects.length > 0 && (
        <>
          <hr class="border-b w-full border-[#EAEAE9]" />
          <section class="flex flex-col gap-6 w-full">
            <h2 class="text-2xl font-aeonik font-bold">
              Also live{"  "}
              <span class="font-hand text-ink-soft text-lg font-normal">
                ({otherProjects.length})
              </span>
            </h2>
            <ProjectGrid projects={otherProjects} client:load />
          </section>
        </>
      )
    }

    <hr class="w-full text-line" />
    <Footer class="block" />
  </div>
</Layout>
