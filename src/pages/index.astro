---
import BlogPost from "../components/BlogPost.astro"
import Layout from "../layouts/Layout.astro"
import { projects } from "../data/project.ts"
import "../styles/global.css"
import ProjectCard from "../components/ProjectCard.tsx"
import Footer from "../components/Footer.astro"

const MAX_POSTS = 3
const allPosts = Object.values(
  import.meta.glob("./posts/*.md", { eager: true })
).slice(0, MAX_POSTS)

const MAX_NOTES = 5
const allNotes = Object.values(
  import.meta.glob("./notes/*.md", { eager: true })
).slice(0, MAX_NOTES)

const time = new Date().toLocaleTimeString([], {
  hour: "2-digit",
  minute: "2-digit",
})

const greetings = [
  {
    before: "12:00",
    label: "Good morning",
    icon: "i-ph-cloud-fill",
  },
  {
    before: "18:00",
    label: "Good afternoon",
    icon: "i-ph-cloud-sun-fill",
  },
  {
    before: "24:00",
    label: "Good evening",
    icon: "i-ph-cloud-moon-fill",
  },
]

const { icon, label } = greetings.find((greeting) => time < greeting.before)!

// if it is mobile, show the first 3 featured projects, else show all featured projects
const featuredProjects = projects.filter((project) => project.featured)
---

<Layout>
  <div class="grid gap-6 mx-2">
    <div class="text-[#00000066] order-2 lg:order-1">
      <p class="flex gap-2.5 items-center text-sm">
        <span class={icon}></span>
        {label} &#x2022; {time}
      </p>
    </div>
    <img
      src="/notionface.png"
      alt="avatar"
      class="size-52 mx-auto lg:mx-0 md:mx-0 order-1 lg:order-2"
    />
    <div class="flex flex-col gap-6 order-3">
      <div class="flex gap-2 text-wrap">
        <h1 class="text-3xl md:text-5xl flex font-aeonik font-bold">
          Hi, I'm Adwoa Addo-Brako
        </h1>
        <!-- <div class="flex items-center">
          <span class="text-[#00000066] md:text-sm font-bold i-lucide-volume-2"
          ></span>{" "}
          <span class="text-[#00000066] md:text-sm font-bold">Ah-jwah</span>
        </div> -->
      </div>

      <p class="font-aeonik text-base leading-6">
        I build interfaces that feel considered, currently at Dexwin Tech,
        working on bringing African products to a world class standard. I also
        read too much, think alot about the web and solve word searches p.s
        there's one waiting for you ;)
      </p>
    </div>
    <Footer class="block lg:hidden order-4" />
    <hr class="border-b w-full border-[#EAEAE9] order-5" />
    <section class="flex flex-col py-4 gap-6 w-full order-6">
      <h2 class="capitalize text-secondary">Featured Projects</h2>
      <div class="flex gap-3 flex-wrap justify-center md:justify-start">
        {
          featuredProjects.length > 0 ? (
            featuredProjects.map((project) => {
              return (
                <ProjectCard
                  title={project.title}
                  description={project.description}
                  imgsrc={project.imgsrc}
                />
              )
            })
          ) : (
            <code> // No featured projects yet</code>
          )
        }
      </div>
    </section>
    <hr class="border-b w-full border-[#EAEAE9] order-7" />
    <section class="flex flex-col py-4 gap-6 w-full order-8">
      <h2 class="capitalize text-secondary">Lastest Posts</h2>
      <div class="flex flex-col gap-2">
        {
          allPosts.length > 0 ? (
            allPosts.slice(0, MAX_POSTS).map((post: any) => {
              return (
                <BlogPost
                  href={post.url}
                  title={post.frontmatter.title}
                  date={post.frontmatter.pubDate}
                />
              )
            })
          ) : (
            <code> // No featured projects yet</code>
          )
        }
      </div>
    </section>
  </div>
</Layout>
