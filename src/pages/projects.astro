---
import Layout from "../layouts/Layout.astro"
import { projects } from "../data/project.ts"
import ProjectsBoard from "../components/ProjectsBoard.tsx"
import "../styles/global.css"
---

<Layout pageTitle="Projects | missbaah">
  <section class="flex flex-col gap-8 mt-10">
    <p class="text-gray-500 font-aeonik">
      Here are some of the projects I'm currently working on, and some of the
      projects I've worked on in the past. <br /> You can also check out my <a
        class="text-blue-500 hover:underline font-bold"
        href="https://github.com/missbaah"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub profile
      </a>
    </p>
    <hr class="border-b w-4/5 border-[#EAEAE9]" />
    <ProjectsBoard projects={projects} client:load />
  </section>
</Layout>
