---
import Layout from "../layouts/Layout.astro"
import "../styles/global.css"
import GreetingClock from "../components/GreetingClock.tsx"
import WordSearch from "../components/WordSearch.tsx"
import Footer from "../components/Footer.astro"
---

<Layout pageTitle="About | missbaah">
  <div class="flex flex-col gap-8 mt-5">
    <div
      class="text-ink-soft flex flex-col gap-1 md:gap-5 md:flex-row md:items-center w-full"
    >
      <GreetingClock client:load />
      <!-- <span class="hidden md:block">&#47;</span>
      <div class="flex gap-1 items-center text-sm">
        reading <a
          class="text-blue-500 hover:underline font-bold"
          href="https://www.goodreads.com/book/show/13588394-the-lean-startup"
          >The Lean Startup</a
        >
      </div> -->
    </div>

    <div class="flex flex-col gap-10">
      <div class="flex flex-col md:flex-row gap-6 items-start md:items-center">
        <div
          class="flex flex-col gap-6 md:w-3/4 font-aeonik order-2 md:order-1"
        >
          <h1 class="text-3xl md:text-6xl flex font-bold">
            Hi, I'm Adwoa Baah Addo-Brako
          </h1>
          <p class="text-lg md:text-2xl leading-8">
            I build interfaces that feel considered
          </p>
        </div>
        <img
          src="/notionface.png"
          alt="drawing"
          class="size-24 md:size-44 shrink-0 order-1 md:order-2"
        />
      </div>

      <div
        class="flex flex-col md:flex-row gap-7 text-base leading-6 text-[#3a3935]"
      >
        <div class="flex flex-col gap-2.5 w-fit md:w-2/3">
          <span class="uppercase leading-2.5 text-xs text-ink-soft"
            >Right now</span
          >
          <p class="text-[15.5px] leading-6 text-ink-muted">
            At Dexwin Tech, working on bringing African products to a world
            class standard.
          </p>
        </div>
        <div class="flex flex-col gap-2.5">
          <span class="uppercase leading-2.5 text-xs text-ink-soft"
            >Otherwise</span
          >
          <p class="text-[15.5px] leading-6 text-ink-muted">
            I read too much, think a lot about the web, and solve word searches.
            p.s There's one waiting for you below ;)
          </p>
        </div>
      </div>
      <div
        class="flex flex-col gap-2 border-l-2 border-l-pink-strong py-0.5 pl-4"
      >
        <p class="text-xl leading-7 w-fit md:w-3/4 font-aeonik">
          "Time is going to pass anyways, why don't spend the time making your
          life beautiful"
        </p>
        <p class="text-sm leading-6 text-ink-soft lowercase">
          Guiding Philosophy
        </p>
      </div>
      <Footer class="block" />
    </div>
    <hr class="w-full text-line" />
    <WordSearch client:load />
  </div>
</Layout>
