---
import Layout from "../layouts/Layout.astro"
import "../styles/global.css"
import WordSearch from "../components/WordSearch.tsx"
import Footer from "../components/Footer.astro"
---

<Layout pageTitle="About | Beebe Brako">
  <div class="flex flex-col gap-8 mt-10">
    <div class="flex flex-col gap-10">
      <h1 class="text-3xl md:text-4xl font-aeonik font-bold leading-10">
        About
      </h1>

      <div
        class="flex flex-col md:flex-row gap-7 text-base leading-6 text-[#3a3935]"
      >
        <div class="flex flex-col gap-2.5 w-fit md:w-2/3">
          <span class="text-sm text-ink-soft">Right now</span>
          <p class="text-[15.5px] leading-6 text-ink-muted">
            At Dexwin Tech, working on bringing African products to a world
            class standard.
          </p>
        </div>
        <div class="flex flex-col gap-2.5">
          <span class="text-sm text-ink-soft">Otherwise</span>
          <p class="text-[15.5px] leading-6 text-ink-muted">
            I read too much, think a lot about the web, and solve word searches.
            <span class="marker font-hand text-lg leading-6">p.s there's one waiting for you below ;)</span>
          </p>
        </div>
      </div>
      <!-- A slip of paper taped to the page, with the label scribbled beneath -->
      <figure
        class="relative self-start paper border border-line rounded-sm shadow-sm px-6 pt-7 pb-5 md:px-8 max-w-xl rotate-[0.6deg] flex flex-col gap-3"
      >
        <span
          aria-hidden="true"
          class="absolute -top-3 left-8 h-6 w-20 bg-pink/60 -rotate-3"></span>
        <blockquote class="text-xl leading-8 font-aeonik">
          “Time is going to pass anyways, why don’t you spend the time making
          your life beautiful”
        </blockquote>
        <figcaption class="font-hand text-lg text-ink-soft -rotate-1 self-end">
          — my guiding philosophy
        </figcaption>
      </figure>
      <Footer class="block" />
    </div>
    <hr class="w-full text-line" />
    <WordSearch client:load />
  </div>
</Layout>
